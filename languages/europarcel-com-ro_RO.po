# Customer-facing strings (Frontend)
#: includes/class-europarcel-checkout.php:175
#: includes/class-europarcel-checkout.php:322
msgid "Select Locker"
msgstr "Selectare locker"

#: includes/class-europarcel-shipping.php:264
msgid ""
"Select shipping classes that should not have locker delivery options "
"available (e.g., large products or items unsuitable for lockers)"
msgstr ""
"Selectează clasele de expediere care nu ar trebui să aibă opțiuni de livrare "
"în locker (ex: produse mari sau neadecvate pentru lockere)"

#: includes/class-europarcel-shipping.php:217
msgid ""
"Select shipping classes that will always have free home delivery regardless "
"of order amount"
msgstr ""
"Selectează clasele de expediere care vor avea întotdeauna livrare gratuită "
"la adresă, indiferent de suma comenzii"

#: includes/class-europarcel-shipping.php:254
msgid ""
"Select shipping classes that will always have free locker delivery "
"regardless of order amount"
msgstr ""
"Selectează clasele de expediere care vor avea întotdeauna livrare gratuită "
"în locker, indiferent de suma comenzii"

#: includes/class-europarcel-shipping.php:177
msgid ""
"Select the shipping services that will be available to your customers during "
"checkout"
msgstr ""
"Selectează serviciile de transport care vor fi disponibile clienților la "
"finalizarea comenzii"

#: includes/class-europarcel-shipping.php:153
msgid "Service Configuration"
msgstr "Configurarea serviciilor"

#: includes/class-europarcel-shipping.php:201
