"The shipping method name shown to customers at checkout for home delivery"
msgstr ""
"Numele metodei de transport afișat clienților la checkout pentru livrarea la "
"adresă"

#: includes/class-europarcel-shipping.php:231
msgid ""
"The shipping method name shown to customers at checkout for locker delivery"
msgstr ""
"Numele metodei de transport afișat clienților la checkout pentru livrarea în "
"locker"

#: includes/class-europarcel-shipping.php:101
msgid ""
"The shipping method title displayed in the admin shipping zones configuration"
msgstr ""
"Titlul metodei de transport afișat în configurarea zonelor de transport din "
"admin"

#: includes/class-europarcel-shipping.php:126
msgid "Unable to connect to eAWB."
msgstr "Nu se poate conecta la eAWB."

